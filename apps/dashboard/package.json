    "@stylexjs/stylex": "^0.19.0",
    "@zk-kit/lean-imt": "2.2.5",
    "next": "^15.5.25",
    "poseidon-lite": "^0.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@warrant/core": "workspace:*",
    "@warrant/x402": "workspace:*",
    "mocha": "^10.8.2",
