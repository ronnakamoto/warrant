{
  "name": "warrant",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "test": "node scripts/check-boundaries.mjs && mocha && pnpm --filter @warrant/core test && pnpm --filter @warrant/x402 test && pnpm --filter @warrant/translate test && pnpm --filter @warrant/agent test && pnpm --filter @warrant/prove test && pnpm --filter @warrant/dashboard test",
    "test:prove": "pnpm --filter @warrant/prove test",
    "test:dashboard": "pnpm --filter @warrant/dashboard test",
    "test:circuit": "mocha",
    "test:circuit:full": "mocha --config .mocharc.full.cjs",
    "test:core": "NODE_OPTIONS='--import tsx' mocha --no-config --timeout 180000 --exit packages/core/test/**/*.test.ts",
    "test:x402": "pnpm --filter @warrant/x402 test",
    "test:translate": "pnpm --filter @warrant/translate test",
    "test:agent": "pnpm --filter @warrant/agent test",
    "check-boundaries": "node scripts/check-boundaries.mjs",
    "dod": "NODE_OPTIONS='--import tsx' tsx scripts/dod.ts",
    "demo": "pnpm --filter @warrant/agent demo",
    "demo:live": "./scripts/demo-video-dry-run.sh",
    "hosted:dev": "./scripts/hosted-dev.sh"
  },
  "devDependencies": {
    "@semaphore-protocol/group": "4.14.3",
    "@semaphore-protocol/identity": "4.14.3",
    "@zk-kit/binary-merkle-root.circom": "2.0.0",
    "chai": "^4.5.0",
    "circom_tester": "0.0.24",
    "circomlib": "^2.0.5",
    "mocha": "^10.8.2",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.6",
    "tsx": "^4.20.5"
  }
}
