# Public translate host. Build from the monorepo root:
#   docker build -f deploy/Dockerfile.translate -t warrant-translate .
FROM node:22-bookworm-slim
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/core ./packages/core
COPY packages/x402 ./packages/x402
COPY services/translate ./services/translate
RUN pnpm install --frozen-lockfile --filter @warrant/translate...
ENV PORT=8787
ENV NODE_ENV=production
ENV WARRANT_STRICT_PROD=1
EXPOSE 8787
CMD ["pnpm", "--filter", "@warrant/translate", "start"]
