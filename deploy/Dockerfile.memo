# Public memo shop. Build from the monorepo root:
#   docker build -f deploy/Dockerfile.memo -t warrant-memo .
FROM node:22-bookworm-slim
WORKDIR /app
RUN corepack enable && apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/core ./packages/core
COPY packages/x402 ./packages/x402
COPY services/memo ./services/memo
RUN pnpm install --frozen-lockfile --filter @warrant/memo... \
  && mkdir -p /app/circuits/build \
  && curl -L --fail -o /app/circuits/build/warrant_vkey.json \
    https://github.com/ronnakamoto/warrant/releases/download/artifacts-groth16-v1/warrant_vkey.json
ENV PORT=8789
ENV NODE_ENV=production
ENV WARRANT_STRICT_PROD=1
ENV WARRANT_VKEY_PATH=/app/circuits/build/warrant_vkey.json
EXPOSE 8789
CMD ["pnpm", "--filter", "@warrant/memo", "start"]
