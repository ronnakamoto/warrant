#!/usr/bin/env bash
# Export snarkjs Solidity verifier into contracts/src/WarrantVerifier.sol (DO NOT hand-edit).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUILD="${ROOT}/circuits/build"
ZKEY="${BUILD}/warrant_final.zkey"
OUT="${ROOT}/contracts/src/WarrantVerifier.sol"
SNARKJS="${ROOT}/node_modules/snarkjs/cli.js"

if [[ ! -f "$ZKEY" ]]; then
  echo "missing $ZKEY — run scripts/download-zkey.sh or scripts/setup-groth16 first" >&2
  exit 1
fi

TMP="$(mktemp)"
node "$SNARKJS" zkey export solidityverifier "$ZKEY" "$TMP"

node --input-type=module -e "
import { readFileSync, writeFileSync } from 'node:fs';
const src = readFileSync(process.argv[1], 'utf8');
if (!src.includes('verifyProof') || src.length < 1000) {
  console.error('solidity verifier export looks empty/invalid');
  process.exit(1);
}
const body = src
  .replace(/\/\/ SPDX-License-Identifier:[^\n]*\n/, '')
  .replace(/pragma solidity [^;]+;/, 'pragma solidity 0.8.28;')
  .replace(/contract\s+\w+/, 'contract WarrantVerifier');
const out = '// SPDX-License-Identifier: GPL-3.0\n' +
  '/// @dev Generated by \`snarkjs zkey export solidityverifier\`. DO NOT EDIT.\n' +
  body.trimStart();
writeFileSync(process.argv[2], out);
" "$TMP" "$OUT"

rm -f "$TMP"
echo "exported → $OUT ($(wc -c < "$OUT") bytes)"
(cd "${ROOT}/contracts" && forge build)
