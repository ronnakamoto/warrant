# Copy to `.env` and fill secrets. Never commit `.env`.

# ─── Base Sepolia EVM (deploy MandateRegistry, bind-root, dashboard revoke) ───
# Generate: `cast wallet new`  → fund ETH_ADDRESS on Base Sepolia faucet
BASE_SEPOLIA_RPC=https://sepolia.base.org
ETH_PRIVATE_KEY=
ETH_ADDRESS=
# Agent CLI `bind-root` / on-chain ops (same key as ETH_PRIVATE_KEY)
BIND_PRIVATE_KEY=
# After forge deploy:
REGISTRY_ADDRESS=
# Optional operator for MandateRegistry (defaults to deployer if unset)
# WARRANT_BIND_OPERATOR=

# Dashboard (Next.js)
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_REGISTRY_ADDRESS=
# HashPack / Hedera WalletConnect (Let it spend + Cut spend). Fail closed if unset.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Hedera testnet (ECDSA). Paid path + HCS audit ───────────────────────────
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.10311260
HEDERA_EVM_ADDRESS=0x830106c650d995f079f29848d90d4e96b1fcbdb8
HEDERA_PRIVATE_KEY=
HEDERA_TOPIC_ID=0.0.10336558
HEDERA_MIRROR_NODE=https://testnet.mirrornode.hedera.com
BLOCKY402_URL=https://api.testnet.blocky402.com
# Resource-server payTo (must differ from the agent payer account)
# HEDERA_PAY_TO=
# BLOCKY402_FEE_PAYER=0.0.7162784

# ─── Personhood: World Chain 480 (AgentBook read) ────────────────────────────
WORLDCHAIN_CHAIN_ID=480
WORLDCHAIN_RPC=https://worldchain-mainnet.g.alchemy.com/public
AGENTBOOK_ADDRESS=0xA23aB2712eA7BBa896930544C7d6636a96b944dA

# ─── Demo-only fixed root (never production) ─────────────────────────────────
# FIXED_MERKLE_ROOT=
# ALLOW_DEMO_ROOT=1
# ALLOW_DEMO_VERIFY=1

# ─── Groth16 artifacts (CLI prove / translate verify) ──────────────────────────
# WARRANT_WASM_PATH=
# WARRANT_ZKEY_PATH=
# WARRANT_VKEY_PATH=

# ─── Agent / translate runtime ───────────────────────────────────────────────
# WARRANT_STORE=
# TRANSLATE_URL=http://127.0.0.1:8787/v1/translate
# PORT=8787
# WARRANT_REAL_PROVE=1
WARRANT_MIN_TIER=0
# 0 = every successful shop call is a Hedera 402. That is the product.
WARRANT_FREE_CALLS=0
# Durable nullifiers. Process default: ~/.warrant/nullifiers.json
# WARRANT_NULLIFIER_PATH=/tmp/warrant-nullifiers.json
# Prefer registry + WARRANT_VKEY_PATH; ALLOW_DEMO_* is smoke-only.
# Public host MUST set this (or NODE_ENV=production). Demo flags then fail boot.
# WARRANT_STRICT_PROD=1

# ─── Hosted guest prove worker (services/prove) ──────────────────────────────
# Local: ./scripts/hosted-dev.sh  → translate :8787, prove :8788, dashboard :3001
# Public host: WARRANT_STRICT_PROD=1 and NODE_ENV=production. Never ALLOW_DEMO_*.
PROVE_URL=http://127.0.0.1:8788
# PROVE_SECRET=
# PROVE_PORT=8788
# GUEST_TTL_MS=604800000
# Durable guest sessions (mode 0o600). hosted-dev.sh default: /tmp/warrant-guest-sessions.json
# Multiple prove processes on one host may share this file (lock + reload). Do not share it across machines.
# WARRANT_SESSION_PATH=
# Distinct from BIND_PRIVATE_KEY and from Alice ETH_PRIVATE_KEY.
# GAS_SPONSOR_PRIVATE_KEY=
# DASHBOARD_ORIGIN=https://app.example
# PROVE_ALLOWED_ORIGINS=https://app.example
# TURNSTILE_SECRET=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TRANSLATE_URL=http://127.0.0.1:8787/v1/translate
# WARRANT_NULLIFIER_PATH=/data/nullifiers.json
# Host-pays is not the product. Public host rejects WARRANT_GUEST_SPONSOR.

# ─── The Graph (Subgraph Studio + Agent0 ERC-8004 on Base Sepolia) ──────────
# GRAPH_API_KEY=
# GRAPH_DEPLOY_KEY=
# Studio query URL after `graph deploy` (unpublished Studio subgraphs are not a network id)
# GRAPH_WARRANT_QUERY_URL=https://api.studio.thegraph.com/query/<user>/warrant-mandate-registry/version/latest
# GRAPH_AGENT0_SUBGRAPH_ID=4yYAvQLFjBhBtdRCY7eUWo181VNoTSLLFd5M7FXQAi6u

# ─── Agent namespaces (WP8, optional): Ethereum Sepolia ───────────────────────
SEPOLIA_RPC=https://rpc.sepolia.org
