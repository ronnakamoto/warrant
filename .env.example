# Copy to `.env` and fill secrets. Never commit `.env`.

# ─── Base Sepolia EVM (deploy MandateRegistry, bind-root, dashboard revoke) ───
# Generate: `cast wallet new`  → fund ETH_ADDRESS on Base Sepolia faucet
BASE_SEPOLIA_RPC=https://sepolia.base.org
ETH_PRIVATE_KEY=
ETH_ADDRESS=
# Agent CLI `bind-root` / on-chain ops (same key as ETH_PRIVATE_KEY)
BIND_PRIVATE_KEY=
# After forge deploy:
REGISTRY_ADDRESS=
# Optional operator for MandateRegistry (defaults to deployer if unset)
# WARRANT_BIND_OPERATOR=

# Dashboard (Next.js)
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_REGISTRY_ADDRESS=

# ─── Hedera testnet (ECDSA). Paid path + HCS audit ───────────────────────────
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.10311260
HEDERA_EVM_ADDRESS=0x830106c650d995f079f29848d90d4e96b1fcbdb8
HEDERA_PRIVATE_KEY=
HEDERA_TOPIC_ID=0.0.10336558
HEDERA_MIRROR_NODE=https://testnet.mirrornode.hedera.com
BLOCKY402_URL=https://api.testnet.blocky402.com
# Resource-server payTo (must differ from the agent payer account)
# HEDERA_PAY_TO=
# BLOCKY402_FEE_PAYER=0.0.7162784

# ─── Personhood: World Chain 480 (AgentBook read) ────────────────────────────
WORLDCHAIN_CHAIN_ID=480
WORLDCHAIN_RPC=https://worldchain-mainnet.g.alchemy.com/public
AGENTBOOK_ADDRESS=0xA23aB2712eA7BBa896930544C7d6636a96b944dA

# ─── Demo-only fixed root (never production) ─────────────────────────────────
# FIXED_MERKLE_ROOT=
# ALLOW_DEMO_ROOT=1
# ALLOW_DEMO_VERIFY=1

# ─── Groth16 artifacts (CLI prove / translate verify) ──────────────────────────
# WARRANT_WASM_PATH=
# WARRANT_ZKEY_PATH=
# WARRANT_VKEY_PATH=

# ─── Agent / translate runtime ───────────────────────────────────────────────
# WARRANT_STORE=
# TRANSLATE_URL=http://127.0.0.1:8787/v1/translate
# PORT=8787
# WARRANT_REAL_PROVE=1
WARRANT_MIN_TIER=0
# WARRANT_FREE_CALLS=3

# ─── Agent namespaces (WP8, optional): Ethereum Sepolia ───────────────────────
SEPOLIA_RPC=https://rpc.sepolia.org
