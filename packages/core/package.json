{
  "name": "@warrant/core",
  "version": "0.1.0",
  "description": "Warrant domain, Groth16 prove/verify, eight public signals. No HTTP.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=20.18.0" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "NODE_OPTIONS='--import tsx' pnpm -w exec mocha --no-config --timeout 180000 --exit packages/core/test/**/*.test.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@semaphore-protocol/group": "4.14.3",
    "@semaphore-protocol/identity": "4.14.3",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "mocha": "^10.8.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
