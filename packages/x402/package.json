{
  "name": "@warrant/x402",
  "version": "0.1.0",
  "description": "Wrap a Hono POST with Warrant + Hedera Exact x402.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=20.18.0" },
  "main": "./dist/index.js",
