  },
  "peerDependencies": {
    "hono": "^4.13.7",
    "viem": "^2.56.3"
  },
  "dependencies": {
    "@warrant/core": "workspace:*",
    "@x402/core": "2.24.0",
    "@x402/hedera": "2.24.0",
    "@x402/hono": "2.24.0"
  },
  "devDependencies": {
    "hono": "^4.13.7",
    "viem": "^2.56.3",
    "mocha": "^10.8.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
