{
  "name": "@ronnakamoto/warrant",
  "version": "0.1.0",
  "description": "Warrant agent CLI. Ready and act on this machine. Never print keys.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=20.18.0" },
  "bin": {
    "warrant": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "tsx src/cli.ts",
    "demo": "tsx demo/session.ts",
    "demo:prepare": "tsx demo/session.ts --prepare-only",
    "test": "NODE_OPTIONS='--import tsx' pnpm -w exec mocha --no-config --timeout 120000 --exit packages/agent/test/**/*.test.ts"
  },
  "dependencies": {
    "@ronnakamoto/warrant-core": "workspace:*",
    "@x402/core": "2.24.0",
    "@x402/fetch": "2.24.0",
    "@x402/hedera": "2.24.0",
    "uqr": "^0.1.3",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "mocha": "^10.8.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
